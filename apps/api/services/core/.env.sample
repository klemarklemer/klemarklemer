# Basic Candi env configuration
ENVIRONMENT=development #development,staging,production
DEBUG_MODE=true
LOAD_CONFIG_TIMEOUT=20s

# Application Service Handlers
## Server
USE_REST=true
USE_GRPC=false
USE_GRAPHQL=false
## Worker
USE_KAFKA_CONSUMER=false # event driven handler
USE_CRON_SCHEDULER=false # static scheduler
USE_REDIS_SUBSCRIBER=false # dynamic scheduler
USE_TASK_QUEUE_WORKER=false
USE_POSTGRES_LISTENER_WORKER=false
USE_RABBITMQ_CONSUMER=false # event driven handler and dynamic scheduler

# use shared listener setup shared port to http & grpc listener (if true, use HTTP_PORT value)
USE_SHARED_LISTENER=false
HTTP_PORT=8000
GRPC_PORT=8002

TASK_QUEUE_DASHBOARD_PORT=8080
TASK_QUEUE_DASHBOARD_MAX_CLIENT=5

GRAPHQL_DISABLE_INTROSPECTION=false
HTTP_ROOT_PATH=""

BASIC_AUTH_USERNAME=user
BASIC_AUTH_PASS=pass

MONGODB_HOST_WRITE=mongodb://user:pass@localhost:27017/core?authSource=admin
MONGODB_HOST_READ=mongodb://user:pass@localhost:27017/core?authSource=admin

SQL_DB_READ_DSN=postgres://user:pass@localhost:5432/klemarklemer_db?sslmode=disable&TimeZone=Asia/Jakarta
SQL_DB_WRITE_DSN=postgres://user:pass@localhost:5432/klemarklemer_db?sslmode=disable&TimeZone=Asia/Jakarta

REDIS_READ_DSN=redis://:pass@localhost:6379/0
REDIS_WRITE_DSN=redis://:pass@localhost:6379/0

KAFKA_BROKERS=localhost:9092 # if multiple broker, separate by comma with no space
KAFKA_CLIENT_VERSION=2.0.0
KAFKA_CLIENT_ID=core
KAFKA_CONSUMER_GROUP=core

# RABBITMQ_BROKER=amqp://guest:guest@localhost:5672/test
# RABBITMQ_CONSUMER_GROUP=core
# RABBITMQ_EXCHANGE_NAME=delayed

OTEL_TRACING_HOST=127.0.0.1:4317

MAX_GOROUTINES=10

# Additional env for your service


# Assessment Agent (Loop 3).
# With a key set, recommendations come from Gemini. Without one the service still
# boots and applies the same underwriting rules deterministically - check the
# startup log line "assessment agent engine -> ..." to see which is active.
GEMINI_MODEL=gemini-3.5-flash

# Backend A - Gemini API. Simplest for local work.
GEMINI_API_KEY=

# Backend B - Vertex AI. Calls appear in Google Cloud Console, which is the
# accepted proof that the backend runs on Google Cloud. Authenticates through
# application default credentials (gcloud auth application-default login),
# so no API key is needed here.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-southeast1
